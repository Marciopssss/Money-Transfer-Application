@* File: Views/Beneficiaries/Index.cshtml *@
@model List<SwiftPay.Models.Beneficiary>
@{
    ViewData["Title"] = "Beneficiaries";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section PageContent {

    <div class="db-topbar">
        <div>
            <div class="db-greeting">Beneficiaries</div>
            <div class="db-date">Your saved recipients</div>
        </div>
        <a href="@Url.Action("Add")" class="ft-btn" style="width:auto;padding:10px 20px;">+ Add Beneficiary</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background:rgba(62,201,142,0.08);border:1px solid rgba(62,201,142,0.2);border-radius:10px;padding:12px 16px;margin-bottom:1.5rem;color:#3EC98E;font-size:13px;">
            ✅ @TempData["Success"]
        </div>
    }

    <div class="db-txn-list">
        @if (!Model.Any())
        {
            <div style="text-align:center;padding:3rem;color:#3A4060;font-size:13px;">
                No beneficiaries yet. <a href="@Url.Action("Add")" style="color:#4F8EF7;">Add your first one →</a>
            </div>
        }
        else
        {
            @foreach (var b in Model)
            {
                <div class="db-txn-row">
                    <div class="db-txn-icon recv" style="font-size:13px;font-weight:600;">
                        @b.FullName.Substring(0, 1).ToUpper()
                    </div>
                    <div class="db-txn-info">
                        <div class="db-txn-name">@b.FullName</div>
                        <div class="db-txn-id">
                            @(b.AccountSerial ?? b.MobileNumber ?? b.Email ?? "No contact info")
                            @if (b.BankName != null)
                            {
                                <span> · @b.BankName</span>
                            }
                        </div>
                    </div>
                    <div style="display:flex;gap:8px;">
                        <a href="@Url.Action("Send","Transfer", new { beneficiaryId = b.Id })"
                           style="background:rgba(79,142,247,0.1);border:1px solid rgba(79,142,247,0.25);color:#4F8EF7;font-size:11px;padding:5px 12px;border-radius:7px;text-decoration:none;">
                            Send
                        </a>
                        <form asp-action="Delete" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@b.Id" />
                            <button type="submit" onclick="return confirm('Remove @b.FullName?')"
                                    style="background:rgba(240,96,96,0.1);border:1px solid rgba(240,96,96,0.25);color:#F06060;font-size:11px;padding:5px 12px;border-radius:7px;cursor:pointer;font-family:'Sora',sans-serif;">
                                Remove
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>

}
