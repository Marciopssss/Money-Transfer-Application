@* File: Views/Reviews/Add.cshtml *@
@model SwiftPay.ViewModels.AddReviewViewModel
@{
    ViewData["Title"] = "Write a Review";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section PageContent {

    <div class="db-topbar">
        <div>
            <div class="db-greeting">Write a Review</div>
            <div class="db-date">Share your experience with SwiftPay</div>
        </div>
    </div>

    <div style="max-width:500px;">
        <form method="post" action="/Reviews/Add">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background:rgba(240,96,96,0.08);border:1px solid rgba(240,96,96,0.2);border-radius:10px;padding:12px 14px;margin-bottom:1.5rem;color:#F06060;font-size:13px;">
                    <asp-validation-summary asp-validation-type="All" />
                </div>
            }

            <div style="background:#111420;border:1px solid #1A1E30;border-radius:16px;padding:1.5rem;margin-bottom:1.5rem;">

                <label class="ft-label">Your Rating</label>
                <div style="display:flex;gap:8px;margin-bottom:1.5rem;" id="star-container">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span onclick="setRating(@i)" id="star-@i"
                              style="font-size:32px;cursor:pointer;color:@(i <= 5 ? "#FFB432" : "#3A4060");transition:transform .1s;">★</span>
                    }
                </div>
                <input type="hidden" name="Rating" id="rating-input" value="5" />

                <label class="ft-label">Your Comment</label>
                <textarea name="Comment" class="send-input" rows="5"
                          placeholder="Tell us about your experience with SwiftPay..."
                          style="resize:vertical;"></textarea>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                <button type="submit" class="ft-btn">Submit Review</button>
                <a href="@Url.Action("Index")" class="ft-btn" style="background:#1A1E34;border:1px solid #2A2E50;color:#7B9FFF;text-align:center;">Cancel</a>
            </div>
        </form>
    </div>

    <style>
        .send-input {
            width: 100%;
            background: #0D0F1A;
            border: 1px solid #1E2236;
            border-radius: 10px;
            padding: 12px 14px;
            color: #C8CEEA;
            font-family: 'Sora',sans-serif;
            font-size: 14px;
            outline: none;
            margin-bottom: 1.2rem;
            transition: border-color .2s;
            box-sizing: border-box;
        }

            .send-input:focus {
                border-color: #4F8EF7;
            }

            .send-input::placeholder {
                color: #3A4060;
            }
    </style>

    <script>
        let currentRating = 5;
        function setRating(val) {
            currentRating = val;
            document.getElementById('rating-input').value = val;
            for (let i = 1; i <= 5; i++) {
                const star = document.getElementById('star-' + i);
                star.style.color = i <= val ? '#FFB432' : '#3A4060';
                star.style.transform = i === val ? 'scale(1.2)' : 'scale(1)';
            }
        }
    </script>

}
