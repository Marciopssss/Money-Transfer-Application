@* File: Views/Wallet/Exchange.cshtml *@
@model SwiftPay.ViewModels.ExchangeViewModel
@{
    ViewData["Title"] = "Currency Exchange";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section PageContent {

    <div class="db-topbar">
        <div>
            <div class="db-greeting">Currency Exchange</div>
            <div class="db-date">Balance: <strong style="color:#3EC98E;">@Model.Balance.ToString("C")</strong> · @Model.AccountSerial</div>
        </div>
    </div>

    @if (Model.Exchanged)
    {
        <div style="background:rgba(62,201,142,0.08);border:1px solid rgba(62,201,142,0.2);border-radius:12px;padding:1.2rem 1.5rem;margin-bottom:1.5rem;color:#3EC98E;font-size:13px;">
            ✅ Exchange successful! <strong>@Model.Amount.ToString("C") @Model.FromCurrency</strong>
            converted to <strong>@Model.ConvertedAmount.ToString("N2") @Model.ToCurrency</strong>
            at rate <strong>1 @Model.FromCurrency = @Model.ExchangeRate @Model.ToCurrency</strong>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="ft-error-box" style="margin-bottom:1.5rem;">
            @foreach (var state in ViewData.ModelState.Values)
            {
                @foreach (var error in state.Errors)
                {
                    <div>⚠️ @error.ErrorMessage</div>
                }
            }
        </div>
    }

    <div style="max-width:500px;">
        <form method="post" action="/Wallet/Exchange">
            @Html.AntiForgeryToken()

            <div style="background:#111420;border:1px solid #1A1E30;border-radius:16px;padding:1.5rem;margin-bottom:1.2rem;">

                <label class="ft-label">Amount to Convert</label>
                <input name="Amount" id="ex-amount" class="send-input" type="number"
                       step="0.01" min="0.01" placeholder="0.00"
                       value="@(Model.Amount > 0 ? Model.Amount.ToString() : "")"
                       oninput="calcExchange()" />

                <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center;margin-bottom:1.2rem;">
                    <div>
                        <label class="ft-label">From</label>
                        <select name="FromCurrency" id="ex-from" class="send-select" style="margin-bottom:0;" onchange="calcExchange()">
                            @{
                                var allCurrencies = new[] { "USD", "EUR", "GBP", "LBP", "AED", "SAR" };
                            }
                            @foreach (var c in allCurrencies)
                            {
                                if (Model.FromCurrency == c)
                                {
                                    <option value="@c" selected="selected">@c</option>
                                }
                                else
                                {
                                    <option value="@c">@c</option>
                                }
                            }
                        </select>
                    </div>
                    <div style="text-align:center;">
                        <button type="button" onclick="swapCurrencies()"
                                style="background:#1A1E34;border:1px solid #2A2E50;border-radius:50%;width:36px;height:36px;color:#7B9FFF;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;margin-top:18px;">
                            ⇄
                        </button>
                    </div>
                    <div>
                        <label class="ft-label">To</label>
                        <select name="ToCurrency" id="ex-to" class="send-select" style="margin-bottom:0;" onchange="calcExchange()">
                            @foreach (var c in allCurrencies)
                            {
                                if (Model.ToCurrency == c)
                                {
                                    <option value="@c" selected="selected">@c</option>
                                }
                                else
                                {
                                    <option value="@c">@c</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- Live preview -->
                <div id="ex-preview" style="background:#0D0F1A;border:1px solid #1E2236;border-radius:12px;padding:1rem 1.2rem;display:none;">
                    <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
                        <span style="font-size:12px;color:#4A5070;">Exchange Rate</span>
                        <span style="font-size:13px;color:#7B9FFF;font-family:'Space Mono',monospace;" id="ex-rate">—</span>
                    </div>
                    <div style="height:1px;background:#1E2236;margin:8px 0;"></div>
                    <div style="display:flex;justify-content:space-between;">
                        <span style="font-size:12px;color:#4A5070;">You will receive</span>
                        <span style="font-size:16px;color:#3EC98E;font-weight:700;font-family:'Space Mono',monospace;" id="ex-result">—</span>
                    </div>
                </div>
            </div>

            <button type="submit" class="ft-btn">Convert Now →</button>
            <a href="@Url.Action("Index","Dashboard")" class="ft-btn"
               style="margin-top:10px;background:#1A1E34;border:1px solid #2A2E50;color:#7B9FFF;">
                ← Back to Dashboard
            </a>
        </form>
    </div>

    <script>
        const rates = {
            'USD_EUR':0.92,'EUR_USD':1.09,'USD_GBP':0.79,'GBP_USD':1.27,
            'USD_LBP':89500,'LBP_USD':0.0000112,'USD_AED':3.67,'AED_USD':0.27,
            'USD_SAR':3.75,'SAR_USD':0.27,'EUR_GBP':0.86,'GBP_EUR':1.16,
            'AED_EUR':0.25,'EUR_AED':4.01,'SAR_EUR':0.25,'EUR_SAR':4.08
        };

        function calcExchange() {
            const amount  = parseFloat(document.getElementById('ex-amount').value);
            const from    = document.getElementById('ex-from').value;
            const to      = document.getElementById('ex-to').value;
            const preview = document.getElementById('ex-preview');

            if (!amount || amount <= 0 || from === to) { preview.style.display='none'; return; }

            const key    = from + '_' + to;
            const rate   = rates[key] || 1;
            const result = (amount * rate).toFixed(2);

            document.getElementById('ex-rate').textContent   = `1 ${from} = ${rate} ${to}`;
            document.getElementById('ex-result').textContent = `${result} ${to}`;
            preview.style.display = 'block';
        }

        function swapCurrencies() {
            const from = document.getElementById('ex-from');
            const to   = document.getElementById('ex-to');
            const temp = from.value;
            from.value = to.value;
            to.value   = temp;
            calcExchange();
        }

        document.addEventListener('DOMContentLoaded', calcExchange);
    </script>

}
