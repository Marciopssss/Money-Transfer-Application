@model SwiftPay.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SwiftPay — @ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="ft-wrap">
        <div class="ft-card">

         
            <div class="ft-logo">
                <div class="ft-logo-mark">
                    <svg viewBox="0 0 20 20" fill="white" width="18" height="18">
                        <path d="M10 2L3 7v6l7 5 7-5V7L10 2zm0 2.5L15 8v4l-5 3.5L5 12V8l5-3.5z" />
                    </svg>
                </div>
                <span class="ft-logo-name">SWIFTPAY</span>
            </div>

            <div class="ft-tabs">
                <div class="ft-tab active" id="tab-login" onclick="showTab('login')">Sign In</div>
                <div class="ft-tab" id="tab-signup" onclick="showTab('signup')">Create Account</div>
            </div>


            <div id="panel-login">
                <h1 class="ft-heading">Welcome back</h1>
                <p class="ft-sub">Sign in to your SwiftPay account</p>

                <form method="post" action="/Auth/Login">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                    <label class="ft-label">Email address</label>
                    <input name="Email" class="ft-input" type="email" placeholder="you@example.com" autocomplete="email" />

                    <label class="ft-label">Password</label>
                    <div class="ft-input-wrap">
                        <input name="Password" class="ft-input" type="password" placeholder="••••••••" id="login-pass" style="margin-bottom:0;padding-right:42px;" />
                        <span class="ft-eye" onclick="togglePass('login-pass', this)">👁</span>
                    </div>

                    <div class="ft-forgot">
                        <a href="/Auth/ForgotPassword">Forgot password?</a>
                    </div>

                    @if (ViewData.ModelState[""]?.Errors.Count > 0)
                    {
                        <div class="ft-error-box">
                            @foreach (var error in ViewData.ModelState[""].Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <button type="submit" class="ft-btn">Sign In</button>
                </form>

                <div class="ft-divider">
                    <div class="ft-divider-line"></div>
                    <span class="ft-divider-text">or continue with</span>
                    <div class="ft-divider-line"></div>
                </div>

                <div class="ft-social">
                    <form method="post" action="/Auth/ExternalLogin" style="display:contents;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="provider" value="Google" />
                        <input type="hidden" name="returnUrl" value="/" />
                        <button type="submit" class="ft-social-btn">
                            <svg width="14" height="14" viewBox="0 0 24 24">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05" />
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                            </svg>
                            Google
                        </button>
                    </form>

                    <form method="post" action="/Auth/ExternalLogin" style="display:contents;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="provider" value="Facebook" />
                        <input type="hidden" name="returnUrl" value="/" />
                        <button type="submit" class="ft-social-btn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="#1877F2">
                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                            </svg>
                            Facebook
                        </button>
                    </form>

                    <form method="post" action="/Auth/ExternalLogin" style="display:contents;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="provider" value="Apple" />
                        <input type="hidden" name="returnUrl" value="/" />
                        <button type="submit" class="ft-social-btn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="#E8EAFF">
                                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
                            </svg>
                            Apple
                        </button>
                    </form>
                </div>

                <p class="ft-note">Don't have an account? <span onclick="showTab('signup')">Create one</span></p>
            </div>

            
            <div id="panel-signup" class="hidden">
                <h1 class="ft-heading">Get started</h1>
                <p class="ft-sub">Create your SwiftPay account in seconds</p>

                <form method="post" action="/Auth/Register">
                    @Html.AntiForgeryToken()

                    <div class="ft-row">
                        <div>
                            <label class="ft-label">First name</label>
                            <input name="FirstName" class="ft-input" type="text" placeholder="Ali" />
                        </div>
                        <div>
                            <label class="ft-label">Last name</label>
                            <input name="LastName" class="ft-input" type="text" placeholder="Hassan" />
                        </div>
                    </div>

                    <label class="ft-label">Email address</label>
                    <input name="Email" class="ft-input" type="email" placeholder="you@example.com" />

                    <label class="ft-label">Phone number</label>
                    <input name="PhoneNumber" class="ft-input" type="tel" placeholder="+961 xx xxx xxx" />

                    <label class="ft-label">Preferred currency</label>
                    <select name="PreferredCurrency" class="ft-select">
                        <option value="USD">🇺🇸 USD — US Dollar</option>
                        <option value="EUR">🇪🇺 EUR — Euro</option>
                        <option value="GBP">🇬🇧 GBP — British Pound</option>
                        <option value="LBP">🇱🇧 LBP — Lebanese Pound</option>
                        <option value="AED">🇦🇪 AED — UAE Dirham</option>
                        <option value="SAR">🇸🇦 SAR — Saudi Riyal</option>
                    </select>

                    <label class="ft-label">Password</label>
                    <div class="ft-input-wrap">
                        <input name="Password" class="ft-input" type="password" placeholder="Min. 8 characters" id="reg-pass" style="margin-bottom:0;padding-right:42px;" />
                        <span class="ft-eye" onclick="togglePass('reg-pass', this)">👁</span>
                    </div>

                    <label class="ft-label">Confirm Password</label>
                    <input name="ConfirmPassword" class="ft-input" type="password" placeholder="Repeat your password" />

                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="ft-error-box">
                            @foreach (var state in ViewData.ModelState.Values)
                            {
                                @foreach (var error in state.Errors)
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            }
                        </div>
                    }

                    <button type="submit" class="ft-btn" style="margin-top:1.2rem;">Create Account</button>
                </form>

                <p class="ft-note" style="margin-top:1rem;">Already have an account? <span onclick="showTab('login')">Sign in</span></p>
            </div>

        </div>
    </div>

    <script>
        function showTab(tab) {
            document.getElementById('tab-login').classList.toggle('active', tab === 'login');
            document.getElementById('tab-signup').classList.toggle('active', tab === 'signup');
            document.getElementById('panel-login').classList.toggle('hidden', tab !== 'login');
            document.getElementById('panel-signup').classList.toggle('hidden', tab !== 'signup');
        }

        function togglePass(inputId, eyeEl) {
            const input = document.getElementById(inputId);
            input.type = input.type === 'password' ? 'text' : 'password';
            eyeEl.style.color = input.type === 'text' ? '#4F8EF7' : '#3A4060';
        }

        
        document.addEventListener('DOMContentLoaded', function () {
            const errorBox = document.querySelector('#panel-signup .ft-error-box');
            if (errorBox) showTab('signup');
        });
    </script>
</body>
</html>
